rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to reach their own documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default rule: allow authenticated users to read and write everything for now
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
